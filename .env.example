# HTTP port of the API server
PORT=3000

# SQLite database file (created automatically, including its directory)
DB_PATH=./data/aggregator.db

# JSON file with the RSS feeds to parse
FEEDS_CONFIG=./config/feeds.json

# Redis (the docker container published on 6379)
REDIS_URL=redis://127.0.0.1:6379

# How often feeds are re-fetched (milliseconds)
FEED_REFRESH_MS=600000

# Optional TTL for the per-user history sorted set (seconds, 0 = keep forever)
HISTORY_TTL_SECONDS=0

# JWT signing secret and token lifetime - change the secret in production!
JWT_SECRET=dev-secret
JWT_EXPIRES=7d
